<% layout("/layouts/boilerplate") %>

<section class="page-heading">
  <p class="text-uppercase small fw-bold" style="color: var(--brand); letter-spacing: .12em">A little escape awaits</p>
  <h1 class="display-6 fw-bold"><%= searchQuery ? `Stays near “${searchQuery}”` : 'Find your somewhere' %></h1>
  <p>Thoughtful places for your next memorable getaway.</p>
</section>

<% if (alllistings.length) { %>
  <section class="listing-grid" aria-label="Available stays">
    <% for (const listing of alllistings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <article class="card listing-card">
          <img
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=1000&q=80' %>"
            class="card-img-top"
            alt="<%= listing.title %>"
            loading="lazy"
          />
          <div class="card-body">
            <h2 class="card-title h6"><%= listing.title %></h2>
            <p class="card-text"><%= [listing.location, listing.country].filter(Boolean).join(', ') %></p>
            <p class="listing-price"><strong>₹<%= Number(listing.price || 0).toLocaleString("en-IN") %></strong> <span class="text-muted">/ night</span></p>
          </div>
        </article>
      </a>
    <% } %>
  </section>
<% } else { %>
  <section class="empty-state">
    <h2 class="h4">No stays found</h2>
    <p class="mb-3">Try another city or destination.</p>
    <a href="/listings" class="btn btn-brand">See all stays</a>
  </section>
<% } %>
