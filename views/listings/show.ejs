<% layout("/layouts/boilerplate") %>

<article class="detail-panel mx-auto" style="max-width: 920px">
  <img
    src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=1400&q=85' %>"
    class="show-img"
    alt="<%= listing.title %>"
  />
  <div class="detail-content">
    <p class="detail-meta mb-2"><i class="fa-solid fa-location-dot me-1" style="color: var(--brand)"></i> <%= [listing.location, listing.country].filter(Boolean).join(', ') %></p>
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
      <div>
        <h1 class="h2 fw-bold mb-2"><%= listing.title %></h1>
        <p class="detail-meta mb-0">Hosted by <strong><%= listing.owner ? listing.owner.username : 'Wanderlust host' %></strong></p>
      </div>
      <div class="detail-actions">
      <% if (currUser) { %>
        <% const isSaved = (currUser.savedListings || []).some((savedId) => savedId.toString() === listing._id.toString()); %>
        <form method="POST" action="/saved/<%= listing._id %><%= isSaved ? '?_method=DELETE' : '' %>">
          <input type="hidden" name="returnTo" value="/listings/<%= listing._id %>">
          <button class="ui-btn <%= isSaved ? 'ui-btn--primary' : 'ui-btn--secondary' %> ui-btn--sm" type="submit"><i class="fa-<%= isSaved ? 'solid' : 'regular' %> fa-heart"></i> <%= isSaved ? 'Saved' : 'Save stay' %></button>
        </form>
      <% } %>
      <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="d-flex gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="ui-btn ui-btn--secondary ui-btn--sm"><i class="fa-solid fa-pen"></i> Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing?')">
            <button class="ui-btn ui-btn--danger ui-btn--sm" type="submit"><i class="fa-regular fa-trash-can"></i> Delete</button>
          </form>
        </div>
      <% } %>
      </div>
    </div>
    <p class="mt-4 mb-2"><%= listing.description %></p>
    <p class="h5 mt-4 mb-0"><strong>₹<%= Number(listing.price || 0).toLocaleString("en-IN") %></strong> <span class="detail-meta fs-6">/ night</span></p>
  </div>
</article>

<section class="mx-auto mt-5" style="max-width: 920px">
  <% if (currUser) { %>
    <div class="form-panel mb-4">
      <h2 class="h4 fw-bold">Leave a review</h2>
      <p class="text-muted">How was your experience?</p>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="rating" class="form-label">Rating</label>
          <select id="rating" name="review[rating]" class="form-select" required>
            <option value="">Choose a rating</option>
            <option value="5">★★★★★ — Loved it</option>
            <option value="4">★★★★ — Great</option>
            <option value="3">★★★ — Good</option>
            <option value="2">★★ — Could be better</option>
            <option value="1">★ — Poor</option>
          </select>
          <div class="invalid-feedback">Please choose a rating.</div>
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Your review</label>
          <textarea name="review[comment]" id="comment" rows="4" class="form-control" placeholder="Share a helpful detail for future guests" required></textarea>
          <div class="invalid-feedback">Please write a short review.</div>
        </div>
        <button class="ui-btn ui-btn--primary" type="submit"><i class="fa-regular fa-paper-plane"></i> Post review</button>
      </form>
    </div>
  <% } else { %>
    <div class="detail-panel p-4 mb-4">
      <h2 class="h5 fw-bold">Stayed here?</h2>
      <p class="text-muted mb-3">Log in to share your experience with other travelers.</p>
      <a class="ui-btn ui-btn--brand" href="/login">Log in to review</a>
    </div>
  <% } %>

  <div class="d-flex align-items-end justify-content-between mb-3">
    <div><p class="text-uppercase small fw-bold mb-1" style="color: var(--brand); letter-spacing: .12em">Guest notes</p><h2 class="h4 fw-bold mb-0">Reviews <span class="text-muted">(<%= listing.reviews.length %>)</span></h2></div>
  </div>
  <% if (listing.reviews.length) { %>
    <div class="row g-3">
      <% for (const review of listing.reviews) { %>
        <div class="col-12 col-md-6">
          <article class="review-card">
            <div class="card-body">
              <div class="d-flex justify-content-between gap-3">
                <div>
                  <h3 class="h6 fw-bold mb-1"><%= review.author ? review.author.username : 'Traveler' %></h3>
                  <p class="mb-2" style="color: var(--brand)" aria-label="Rated <%= review.rating %> out of 5"><%= '★'.repeat(review.rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (review.rating || 0)) %></span></p>
                </div>
                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="ui-btn ui-btn--danger ui-btn--sm" type="submit" aria-label="Delete your review"><i class="fa-regular fa-trash-can"></i><span>Delete</span></button>
                  </form>
                <% } %>
              </div>
              <p class="mb-0"><%= review.comment %></p>
            </div>
          </article>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <p class="text-muted">No reviews yet. Be the first to share a note.</p>
  <% } %>
</section>
