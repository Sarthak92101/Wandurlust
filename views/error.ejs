<% layout("/layouts/boilerplate") %>

<section class="error-panel">
  <span class="error-orbit"><img src="/images/wanderlust-mark.svg" alt=""></span>
  <p class="eyebrow">A DETOUR, NOT THE END</p>
  <p class="error-code"><%= err.statusCode || 500 %></p>
  <h1><%= err.statusCode === 404 ? 'We can’t find that place.' : 'Something went off course.' %></h1>
  <p class="error-message"><%= err.message || 'Please try again in a moment.' %></p>
  <a class="ui-btn ui-btn--primary" href="/listings"><i class="fa-solid fa-arrow-left"></i> Back to exploring</a>
  <% if (process.env.NODE_ENV !== 'production' && err.stack) { %>
    <details class="error-details"><summary>Developer details</summary><pre><%= err.stack %></pre></details>
  <% } %>
</section>
